# Identificador do projeto (usado em pastas e nomes de arquivo, sem espaços ou caracteres especiais)
PROJECT_NAME="meu_projeto"

# Nome legível para exibição e notificações
PROJECT_LABEL="Meu Projeto"

# Configurações do Banco de Dados Supabase (Pooler ou Conexão Direta)
DB_HOST="aws-0-sa-east-1.pooler.supabase.com"
DB_PORT="6543"
DB_NAME="postgres"
DB_USER="postgres.seu_project_ref"
PGPASSWORD="sua-senha-aqui"

# Dias de retenção dos arquivos de backup (padrão: 15)
RETENTION_DAYS=15
